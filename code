# ============================================================
# EXPLAINABLE DEEP LEARNING FOR EARLY DISEASE PREDICTION
#
# Educational Offline Project
# Uses synthetic data only
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

from sklearn.inspection import permutation_importance


# ============================================================
# CONFIGURATION
# ============================================================

TOTAL_SAMPLES = 3000
RANDOM_STATE = 42

np.random.seed(RANDOM_STATE)


# ============================================================
# 1. GENERATE SYNTHETIC HEALTH DATA
# ============================================================

def generate_data():

    age = np.random.randint(
        20,
        80,
        TOTAL_SAMPLES
    )

    bmi = np.random.normal(
        25,
        4,
        TOTAL_SAMPLES
    )

    blood_pressure = np.random.normal(
        125,
        18,
        TOTAL_SAMPLES
    )

    glucose = np.random.normal(
        105,
        25,
        TOTAL_SAMPLES
    )

    cholesterol = np.random.normal(
        195,
        35,
        TOTAL_SAMPLES
    )

    heart_rate = np.random.normal(
        75,
        10,
        TOTAL_SAMPLES
    )

    physical_activity = np.random.normal(
        5,
        2,
        TOTAL_SAMPLES
    )

    smoking = np.random.binomial(
        1,
        0.25,
        TOTAL_SAMPLES
    )

    family_history = np.random.binomial(
        1,
        0.30,
        TOTAL_SAMPLES
    )

    sleep_hours = np.random.normal(
        7,
        1.2,
        TOTAL_SAMPLES
    )

    # --------------------------------------------------------
    # Create synthetic risk score
    # --------------------------------------------------------

    risk_score = (

        0.035 * age

        + 0.12 * bmi

        + 0.025 * blood_pressure

        + 0.018 * glucose

        + 0.012 * cholesterol

        + 0.015 * heart_rate

        - 0.20 * physical_activity

        + 1.20 * smoking

        + 1.40 * family_history

        - 0.20 * sleep_hours

        + np.random.normal(
            0,
            1.5,
            TOTAL_SAMPLES
        )

    )

    # --------------------------------------------------------
    # Convert score into binary risk
    # --------------------------------------------------------

    threshold = np.percentile(
        risk_score,
        65
    )

    disease_risk = (
        risk_score > threshold
    ).astype(int)

    data = pd.DataFrame({

        "age": age,

        "bmi": bmi,

        "blood_pressure": blood_pressure,

        "glucose": glucose,

        "cholesterol": cholesterol,

        "heart_rate": heart_rate,

        "physical_activity": physical_activity,

        "smoking": smoking,

        "family_history": family_history,

        "sleep_hours": sleep_hours,

        "disease_risk": disease_risk

    })

    return data


# ============================================================
# 2. DISPLAY DATASET
# ============================================================

def display_dataset(data):

    print("\n")
    print("=" * 70)
    print("SYNTHETIC HEALTH DATASET")
    print("=" * 70)

    print(
        "\nTotal records:",
        len(data)
    )

    print(
        "\nLow-risk records:",
        int(
            (data["disease_risk"] == 0).sum()
        )
    )

    print(
        "Higher-risk records:",
        int(
            (data["disease_risk"] == 1).sum()
        )
    )

    print(
        "\nSample records:"
    )

    print(
        data.head()
    )


# ============================================================
# 3. PREPROCESS DATA
# ============================================================

def preprocess_data(data):

    features = [
        "age",
        "bmi",
        "blood_pressure",
        "glucose",
        "cholesterol",
        "heart_rate",
        "physical_activity",
        "smoking",
        "family_history",
        "sleep_hours"
    ]

    X = data[
        features
    ]

    y = data[
        "disease_risk"
    ]

    X_train, X_test, y_train, y_test = train_test_split(

        X,
        y,

        test_size=0.20,

        random_state=RANDOM_STATE,

        stratify=y
    )

    scaler = StandardScaler()

    X_train_scaled = scaler.fit_transform(
        X_train
    )

    X_test_scaled = scaler.transform(
        X_test
    )

    return (
        X_train,
        X_test,
        X_train_scaled,
        X_test_scaled,
        y_train,
        y_test,
        scaler,
        features
    )


# ============================================================
# 4. CREATE DEEP LEARNING MODEL
# ============================================================

def create_model():

    model = MLPClassifier(

        hidden_layer_sizes=(
            64,
            32,
            16
        ),

        activation="relu",

        solver="adam",

        learning_rate_init=0.001,

        max_iter=400,

        random_state=RANDOM_STATE,

        early_stopping=True,

        validation_fraction=0.15,

        verbose=False

    )

    return model


# ============================================================
# 5. TRAIN MODEL
# ============================================================

def train_model(
    X_train,
    y_train
):

    print("\n")
    print("=" * 70)
    print("DEEP LEARNING MODEL TRAINING")
    print("=" * 70)

    print(
        "\nTraining neural network..."
    )

    model = create_model()

    model.fit(
        X_train,
        y_train
    )

    print(
        "\nTraining completed."
    )

    return model


# ============================================================
# 6. MODEL EVALUATION
# ============================================================

def evaluate_model(
    model,
    X_test,
    y_test
):

    predictions = model.predict(
        X_test
    )

    accuracy = accuracy_score(
        y_test,
        predictions
    )

    precision = precision_score(
        y_test,
        predictions,
        zero_division=0
    )

    recall = recall_score(
        y_test,
        predictions,
        zero_division=0
    )

    f1 = f1_score(
        y_test,
        predictions,
        zero_division=0
    )

    cm = confusion_matrix(
        y_test,
        predictions
    )

    print("\n")
    print("=" * 70)
    print("MODEL EVALUATION")
    print("=" * 70)

    print(
        f"\nAccuracy  : {accuracy * 100:.2f}%"
    )

    print(
        f"Precision : {precision * 100:.2f}%"
    )

    print(
        f"Recall    : {recall * 100:.2f}%"
    )

    print(
        f"F1 Score  : {f1 * 100:.2f}%"
    )

    print(
        "\nClassification Report:"
    )

    print(
        classification_report(
            y_test,
            predictions,
            target_names=[
                "Lower Risk",
                "Higher Risk"
            ]
        )
    )

    print(
        "Confusion Matrix:"
    )

    print(cm)

    return predictions


# ============================================================
# 7. EXPLAINABLE AI USING PERMUTATION IMPORTANCE
# ============================================================

def explain_model(
    model,
    X_test,
    y_test,
    features
):

    print("\n")
    print("=" * 70)
    print("EXPLAINABLE AI ANALYSIS")
    print("=" * 70)

    print(
        "\nCalculating feature importance..."
    )

    result = permutation_importance(

        model,

        X_test,

        y_test,

        n_repeats=10,

        random_state=RANDOM_STATE,

        scoring="accuracy"
    )

    importance = result.importances_mean

    importance_df = pd.DataFrame({

        "Feature": features,

        "Importance": importance

    })

    importance_df = importance_df.sort_values(

        by="Importance",

        ascending=False

    )

    print(
        "\nFeature importance:"
    )

    print(
        importance_df.to_string(
            index=False
        )
    )

    return importance_df


# ============================================================
# 8. PLOT FEATURE IMPORTANCE
# ============================================================

def plot_feature_importance(
    importance_df
):

    plt.figure(
        figsize=(10, 6)
    )

    plt.barh(

        importance_df["Feature"],

        importance_df["Importance"]

    )

    plt.xlabel(
        "Importance"
    )

    plt.ylabel(
        "Health Feature"
    )

    plt.title(
        "Explainable AI - Feature Importance"
    )

    plt.gca().invert_yaxis()

    plt.tight_layout()

    plt.show()


# ============================================================
# 9. PLOT CONFUSION MATRIX
# ============================================================

def plot_confusion_matrix(
    model,
    X_test,
    y_test
):

    predictions = model.predict(
        X_test
    )

    cm = confusion_matrix(
        y_test,
        predictions
    )

    plt.figure(
        figsize=(6, 5)
    )

    plt.imshow(
        cm,
        interpolation="nearest"
    )

    plt.title(
        "Disease Risk Prediction"
    )

    plt.colorbar()

    plt.xticks(
        [0, 1],
        [
            "Lower Risk",
            "Higher Risk"
        ]
    )

    plt.yticks(
        [0, 1],
        [
            "Lower Risk",
            "Higher Risk"
        ]
    )

    plt.xlabel(
        "Predicted"
    )

    plt.ylabel(
        "Actual"
    )

    for i in range(2):

        for j in range(2):

            plt.text(
                j,
                i,
                cm[i, j],
                ha="center",
                va="center"
            )

    plt.tight_layout()

    plt.show()


